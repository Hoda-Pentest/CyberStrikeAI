//go:build windows

package main

import (
	"os/exec"
	"syscall"
)

// prepareHiddenCmd prevents a subprocess from popping up a console window (cmd / powershell / a temporary exe, etc.).
func prepareHiddenCmd(cmd *exec.Cmd) {
	if cmd == nil {
		return
	}
	// Use only HideWindow: equivalent to CREATE_NO_WINDOW, and when cross-compiling Windows on macOS/Linux
	// the syscall.CREATE_NO_WINDOW constant is unavailable.
	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
}
